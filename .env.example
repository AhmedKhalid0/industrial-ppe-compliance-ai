# Application Environment Configuration
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Video Stream Configuration
CAMERA_SOURCE=0  # 0 for default webcam, or RTSP URL: rtsp://user:pass@ip:554/stream
STREAM_FPS_LIMIT=30
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# AI Model Configuration
MODEL_WEIGHTS_PATH=weights/yolov8n-ppe.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.45
DEVICE=cpu  # 'cuda', 'cpu', 'mps'

# Compliance & Debounce Rules
REQUIRED_PPE=helmet,vest
VIOLATION_PERSISTENCE_FRAMES=5
COOLDOWN_SECONDS_PER_WORKER=10

# Database & Alerts
DATABASE_URL=sqlite:///./data/ppe_monitoring.db
SNAPSHOT_DIR=./snapshots
ENABLE_SNAPSHOTS=true
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
